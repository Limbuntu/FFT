FROM docker.m.daocloud.io/library/node:22-bookworm-slim AS frontend

WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM docker.m.daocloud.io/library/golang:1.22-bookworm AS backend

WORKDIR /src
ENV GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=sum.golang.google.cn
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY bench_leaderboard.json ./
COPY --from=frontend /src/frontend/dist ./frontend/dist
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/fft ./cmd/server

FROM docker.m.daocloud.io/library/ubuntu:22.04

ARG USE_INTEL_REPO=0
ARG USE_JELLYFIN_FFMPEG=0
ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i 's|http://archive.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates gpg curl && \
    if [ "$USE_JELLYFIN_FFMPEG" = "1" ]; then \
        curl -fsSL https://repo.jellyfin.org/ubuntu/jellyfin_team.gpg.key | \
            gpg --dearmor -o /usr/share/keyrings/jellyfin.gpg && \
        echo "deb [arch=amd64 signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/ubuntu jammy main" \
            > /etc/apt/sources.list.d/jellyfin.list; \
    else \
        echo "Skipping Jellyfin FFmpeg repository; using Ubuntu FFmpeg"; \
    fi && \
    if [ "$USE_INTEL_REPO" = "1" ]; then \
        curl -fsSL https://repositories.intel.com/gpu/intel-graphics.key | \
            gpg --dearmor -o /usr/share/keyrings/intel-graphics.gpg && \
        echo "deb [arch=amd64 signed-by=/usr/share/keyrings/intel-graphics.gpg] https://repositories.intel.com/gpu/ubuntu jammy unified" \
            > /etc/apt/sources.list.d/intel-gpu.list; \
    else \
        echo "Skipping Intel official GPU repository; using Ubuntu packages for QSV runtime"; \
    fi && \
    apt-get update && \
    if [ "$USE_JELLYFIN_FFMPEG" = "1" ] || [ "$USE_INTEL_REPO" = "1" ]; then \
        packages="intel-media-va-driver-non-free libmfx1 libvpl2 vainfo pciutils" && \
        if [ "$USE_JELLYFIN_FFMPEG" = "1" ]; then packages="$packages jellyfin-ffmpeg7"; else packages="$packages ffmpeg"; fi && \
        if [ "$USE_INTEL_REPO" = "1" ]; then packages="$packages intel-opencl-icd"; fi && \
        apt-get install -y --no-install-recommends $packages; \
    else \
        apt-get install -y --no-install-recommends ffmpeg vainfo pciutils intel-media-va-driver || \
        apt-get install -y --no-install-recommends ffmpeg vainfo pciutils; \
    fi && \
    if [ "$USE_JELLYFIN_FFMPEG" = "1" ]; then \
        ln -sf /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/local/bin/ffmpeg && \
        ln -sf /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe; \
    fi && \
    apt-get purge -y gpg curl && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=backend /out/fft /usr/local/bin/fft
COPY --from=frontend /src/frontend/dist ./frontend/dist
COPY bench_leaderboard.json .

ENV FFT_HOST=0.0.0.0 \
    FFT_PORT=8166 \
    FFT_DATA_DIR=/app/data \
    FFT_STATIC_DIR=/app/frontend/dist

EXPOSE 8166

CMD ["fft"]
